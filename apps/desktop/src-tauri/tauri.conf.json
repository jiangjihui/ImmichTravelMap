{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Immich Travel Map",
  "version": "0.1.0",
  "identifier": "com.immichtravelmap.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Immich Travel Map",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../../server/dist/**/*",
      "../../server/.env",
      "../../web/dist/**/*"
    ]
  }
}
